{
    "comments": {
        "lineComment": ";",
        "blockComment": [ ";;", ";;" ]
    },
    "brackets": [
        ["function", "endfunction"],
        ["struct", "endstruct"],
        ["if", "endif"],
        ["while", "endwhile"],
        ["for", "endfor"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string"] },
        { "open": ";;", "close": ";;", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["\"", "\""]
    ],
    "folding": {
        "markers": {
            "start": "^\\s*(function|struct|if|while|for)\\b",
            "end": "^\\s*(endfunction|endstruct|endif|endwhile|endfor)\\b"
        }
    }
}